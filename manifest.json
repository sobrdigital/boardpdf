{
  "manifestVersion": 5,
  "id": "digital.sobr.artboardpdfexporter",
  "name": "BoardPDF by SOBR",
  "version": "1.1.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "25.0.0",
    "data": {
      "apiVersion": 2
    }
  },
  "requiredPermissions": {
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "artboardPdf",
      "label": {
        "default": "BoardPDF"
      },
      "minimumSize": {
        "width": 300,
        "height": 500
      },
      "preferredDockedSize": {
        "width": 340,
        "height": 720
      },
      "preferredFloatingSize": {
        "width": 360,
        "height": 760
      }
    }
  ]
}
